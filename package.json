{
  "name": "prepline",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-ocr.mjs && vite",
    "build": "node scripts/copy-ocr.mjs && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "prices:kroger": "tsx scripts/fetch-kroger-prices.ts",
    "prices:community": "tsx scripts/fetch-community-prices.ts",
    "build:store": "node scripts/copy-ocr.mjs && VITE_STORE_BUILD=1 vite build",
    "cap:sync": "npm run build:store && cap sync",
    "deploy:worker": "cd worker && npm install && npx wrangler deploy",
    "prices:regional": "tsx scripts/fetch-regional-prices.ts"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.8",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
